{
  "name": "tw-fuzzy-zipcode",
  "version": "0.1.0",
  "description": "Fuzzy free-text Taiwan address -> ZIP code lookup — a dependency-free JS port of moskytw/zipcodetw. Runs entirely client-side.",
  "type": "module",
  "license": "MIT",
  "main": "./src/node.mjs",
  "types": "./src/node.d.ts",
  "exports": {
    ".": {
      "types": "./src/node.d.ts",
      "default": "./src/node.mjs"
    },
    "./browser": {
      "types": "./src/zipcodetw.d.ts",
      "default": "./src/zipcodetw.mjs"
    }
  },
  "files": [
    "src",
    "README.en.md",
    "data/gradual.tsv",
    "data/precise.tsv"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test test/*.js",
    "typecheck": "tsc --project tsconfig.json",
    "build": "python3 scripts/pack.py data/2606_01.csv data",
    "build:golden": "python3 scripts/build_golden_fixture.py data/2606_01.csv test/fixtures/golden_find.tsv"
  },
  "keywords": [
    "taiwan",
    "zipcode",
    "postal-code",
    "郵遞區號",
    "address",
    "fuzzy",
    "fuzzy-search"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
