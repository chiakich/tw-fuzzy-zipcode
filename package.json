{
  "name": "zipcodetw-js",
  "version": "0.1.0",
  "description": "Find Taiwan ZIP code by address, fuzzily — a dependency-free JS port of moskytw/zipcodetw. Runs entirely client-side.",
  "type": "module",
  "license": "MIT",
  "main": "./src/node.mjs",
  "exports": {
    ".": "./src/node.mjs",
    "./browser": "./src/zipcodetw.mjs"
  },
  "files": [
    "src",
    "data/gradual.tsv",
    "data/precise.tsv"
  ],
  "scripts": {
    "test": "node --test",
    "build": "python3 scripts/pack.py data/2102_01.csv data"
  },
  "keywords": [
    "taiwan",
    "zipcode",
    "postal-code",
    "郵遞區號",
    "address"
  ]
}
