{
  "name": "tw-address-tools",
  "version": "0.2.2",
  "description": "Fuzzy Taiwan address lookup, ZIP-code resolution, and English translation — dependency-free and client-side.",
  "type": "module",
  "license": "MIT",
  "main": "./src/node.mjs",
  "types": "./src/node.d.ts",
  "exports": {
    ".": {
      "types": "./src/node.d.ts",
      "default": "./src/node.mjs"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.mjs"
    },
    "./translate": {
      "types": "./src/translate.d.ts",
      "default": "./src/translate.mjs"
    },
    "./mailbox": {
      "types": "./src/mailbox.d.ts",
      "default": "./src/mailbox.mjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "README.en.md",
    "data/gradual.tsv",
    "data/precise.tsv",
    "data/road_en.tsv",
    "data/district_en.tsv",
    "data/mailbox.tsv"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test test/*.js",
    "bench": "node --expose-gc scripts/bench.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "build": "python3 scripts/pack.py data/2606_01.csv data",
    "build:en": "python3 scripts/pack_en.py data",
    "build:mailbox": "python3 scripts/pack_mailbox.py data",
    "fetch:mailbox-en": "python3 scripts/fetch_mailbox_en.py data",
    "build:golden": "python3 scripts/build_golden_fixture.py data/2606_01.csv test/fixtures/golden_find.tsv"
  },
  "keywords": [
    "taiwan",
    "zipcode",
    "postal-code",
    "郵遞區號",
    "address",
    "fuzzy",
    "fuzzy-search",
    "address-translation",
    "english-address"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
